{
  "permissions": {
    "deny": [
      "Bash(git commit *--no-v*)",
      "Bash(git * commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -an*)",
      "Bash(git commit -sn*)",
      "Bash(git commit * -sn*)",
      "Bash(git commit -vn*)",
      "Bash(git commit * -vn*)",
      "Bash(git commit -qn*)",
      "Bash(git commit * -qn*)",
      "Bash(git commit -en*)",
      "Bash(git commit * -en*)",
      "Bash(git * commit -n*)",
      "Bash(git * commit * -n*)",
      "PowerShell(git commit *--no-v*)",
      "PowerShell(git * commit *--no-v*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git commit -an*)",
      "PowerShell(git commit * -an*)",
      "PowerShell(git commit -sn*)",
      "PowerShell(git commit * -sn*)",
      "PowerShell(git commit -vn*)",
      "PowerShell(git commit * -vn*)",
      "PowerShell(git commit -qn*)",
      "PowerShell(git commit * -qn*)",
      "PowerShell(git commit -en*)",
      "PowerShell(git commit * -en*)",
      "PowerShell(git * commit -n*)",
      "PowerShell(git * commit * -n*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/vault_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/env_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret_dump_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_test.py\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_commit_eval.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
