# .env.example
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Never commit your .env file. It is gitignored by default.

# ── Vault ────────────────────────────────────────────────────────────────────

# Absolute path to your private memory vault directory.
# Create this folder before starting Ember (e.g. C:\EmberVault or /data/embervault).
PRIVATE_VAULT_PATH=C:/EmberVault

# ── Developer Vault Paths (optional) ─────────────────────────────────────────

# Known vault paths for the runtime vault swap endpoint
# (POST /v1/developer/vault/swap). Only available when EMBER_DEV_MODE=true.
# These paths must point to directories with full vault structure.
VAULT_PATH_LIVE=C:/EmberVault
VAULT_PATH_DEMO=C:/DEVEmberVault/demo_vault
VAULT_PATH_TEST=C:/DEVEmberVault/test_vault

# Enable developer mode for vault swap and developer status endpoints.
# EMBER_DEV_MODE=true

# Host the API binds to. Use 127.0.0.1 for local-only access,
# or your Tailscale IP (100.x.x.x) to allow access from other devices via Tailscale.
EMBER_HOST=127.0.0.1

# ── Models ───────────────────────────────────────────────────────────────────

# Ollama model used for conversation and reasoning.
# Must be pulled with: ollama pull <model>
EMBER_MODEL=qwen3:8b

# Model used by LOCAL auxiliary LLM calls only: intent classifier (Stage 3),
# coaching filter (identity-collapse detection/rewrite), constitutional
# review, buffer-compression summarization, reflection generation, state
# extraction, deviation detection. Independent of EMBER_MODEL and of the
# UI model switcher -- both of those can point at a generation-host-only
# tag under EMBER_GENERATION_OLLAMA_HOST below, and every auxiliary caller
# here talks to the LOCAL Ollama instance directly, so it must always
# resolve to a model that's actually installed locally.
# Must be pulled with: ollama pull <model>
EMBER_AUXILIARY_MODEL=qwen3:8b

# Embedding model for vector indexing.
# Must be pulled with: ollama pull <model>
EMBER_EMBED_MODEL=nomic-embed-text

# Vision model for analyzing images sent in chat.
# Remove this line or leave it empty to disable image analysis entirely.
EMBER_VISION_MODEL=qwen3-vl:8b

# Optional: run RESPONSE GENERATION against a remote Ollama instance while
# everything else stays on this machine. Leave unset for a normal single-PC
# install -- that is the default and nothing changes.
# Embeddings, vision, and the smaller LLM calls (intent classification,
# coaching filter, grounding check, reflection) deliberately stay local: the
# remote box is unlikely to host nomic-embed-text or a vision model, and each
# small call would otherwise pay a network round trip. Those local calls use
# EMBER_AUXILIARY_MODEL above, not whatever model you pick for generation
# here or in the UI -- see that setting's comment for why.
# The model you select must exist on the remote host.
# EMBER_GENERATION_OLLAMA_HOST=192.168.1.50:11434

# ── API Key ───────────────────────────────────────────────────────────────────

# The API key is stored in Windows Credential Manager, not here.
# Run once after setup to generate and store it:
#   python scripts/set_api_key.py
#
# (Fallback only — for non-Windows or testing environments)
# EMBER_API_KEY=your-key-here

# ── Deviation Engine ─────────────────────────────────────────────────────

# Enable post-hoc behavioral pattern detection (ADR-013, ADR-026).
# When true, Ember detects trained pattern classes in her responses
# and records deviations to the vault. Default: false (opt-in).
EMBER_DEVIATION_DETECTION=false

# Shannon entropy threshold for triggering second-pass classification.
# Lower = more sensitive (more second passes). Default: 0.7.
EMBER_DEVIATION_ENTROPY_THRESHOLD=0.7
