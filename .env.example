# .env.example
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Never commit your .env file. It is gitignored by default.

# ── Vault ────────────────────────────────────────────────────────────────────

# Absolute path to your private memory vault directory.
# Create this folder before starting Ember (e.g. C:\EmberVault or /data/embervault).
PRIVATE_VAULT_PATH=C:/EmberVault

# Host the API binds to. Use 127.0.0.1 for local-only access,
# or your Tailscale IP (100.x.x.x) to allow access from other devices via Tailscale.
EMBER_HOST=127.0.0.1

# ── Models ───────────────────────────────────────────────────────────────────

# Ollama model used for conversation and reasoning.
# Must be pulled with: ollama pull <model>
EMBER_MODEL=qwen3:8b

# Embedding model for vector indexing.
# Must be pulled with: ollama pull <model>
EMBER_EMBED_MODEL=nomic-embed-text

# Vision model for analyzing images sent in chat.
# Remove this line or leave it empty to disable image analysis entirely.
EMBER_VISION_MODEL=llama3.2-vision:11b

# ── API Key ───────────────────────────────────────────────────────────────────

# The API key is stored in Windows Credential Manager, not here.
# Run once after setup to generate and store it:
#   python scripts/set_api_key.py
#
# (Fallback only — for non-Windows or testing environments)
# EMBER_API_KEY=your-key-here
