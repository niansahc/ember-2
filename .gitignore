# Ember memory (never commit)
private_vault/**


# Local AI artifacts
models/
# logs/* rather than logs/ -- git does not descend into an excluded
# directory, so a negation inside logs/ would be inert. Excluding the
# entries instead leaves the directory itself traversable.
logs/*
# Narrow exception: published ablation artifacts. The retrieval-architecture
# ablation is cited in ADRs and issues, and an uncommitted artifact cannot be
# reviewed, reproduced, or checked against the code that produced it -- five
# of seven rows in issue #204's headline table were unverifiable for exactly
# that reason. Only the registry and deliberately published runs are tracked.
!logs/retrieval_eval/
logs/retrieval_eval/*
!logs/retrieval_eval/README.md
!logs/retrieval_eval/published/
!logs/retrieval_eval/published/**
cache/

# UAT runner output (history of automated runs)
uat_results/

# Environment files
.env
.env.local

# Watchdog signal files (runtime only, never committed)
ember_restart.signal
ember_stop.signal

# Python
.venv/
.env
__pycache__/
*.pyc

# Built UI (populated by installer from ember-2-ui)
ui/

# One-time cleanup scripts (not part of the codebase)
scripts/cleanup_today_test_sessions.py

# Local dev tools
watch-cc.ps1

# OS junk
.DS_Store
Thumbs.db

# Your Momgit add .

# Claude Code session lock (runtime only: session id, pid, timestamp)
.claude/scheduled_tasks.lock

# Downstream-deployment design drafts. Voice, multi-user, smart home and
# server-class deployments are built outside this repo, and these drafts
# carry deployment-specific personal detail that the Vault Privacy Rule
# keeps out of the codebase. Draft them here, land them in their own repo.
docs/design/
